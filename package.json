{
  "name": "gooner",
  "version": "0.2.0",
  "description": "Cutie",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "start:watch": "NODE_OPTIONS=--trace-deprecation nodemon -L --delay 500ms --watch dist --ext js,json dist/index.js",
    "start:dev": "concurrently -k npm:build:watch npm:start:watch",
    "start:prod": "npm run build && node dist/index.js"
  },
  "author": "Tekks",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "nodemon": "^3.1.14",
    "@hyperse/ts-node": "^1.2.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "discord.js": "^14.26.4",
    "discord.js-rate-limiter": "^1.3.2",
    "dotenv": "^17.4.2",
    "mariadb": "^3.5.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "watch": [
      "./app/**/*.ts"
    ],
    "ext": "ts",
    "execMap": {
      "ts": "node --loader ts-node/esm ./app/index.ts"
    },
    "delay": 2000
  }
}
