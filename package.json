{
  "name": "gooner",
  "version": "0.1.3",
  "description": "Cutie",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "start:watch": "NODE_OPTIONS=--trace-deprecation nodemon -L --delay 500ms --watch dist --ext js,json dist/index.js",
    "start:dev": "concurrently -k npm:build:watch npm:start:watch",
    "start:prod": "npm run build && node dist/index.js"
  },
  "author": "Tekks",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "@hyperse/ts-node": "^1.1.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "discord.js": "^14.23.2",
    "discord.js-rate-limiter": "^1.3.2",
    "dotenv": "^17.2.3",
    "mariadb": "^3.4.5",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.7",
    "typescript": "^5.9.3"
  },
  "nodemonConfig": {
    "watch": [
      "./app/**/*.ts"
    ],
    "ext": "ts",
    "execMap": {
      "ts": "node --loader ts-node/esm ./app/index.ts"
    },
    "delay": "2000"
  }
}
